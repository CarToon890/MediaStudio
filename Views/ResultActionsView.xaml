<UserControl x:Class="MediaStudio.Views.ResultActionsView" x:Name="Root" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
 <WrapPanel>
  <ui:Button MinHeight="36" FocusVisualStyle="{StaticResource KeyboardFocus}" Content="เปิดไฟล์" Appearance="Primary" Command="{Binding OpenFileCommand, ElementName=Root}" CommandParameter="{Binding CommandParameter, ElementName=Root}" Margin="0,0,8,8"/>
  <ui:Button MinHeight="36" FocusVisualStyle="{StaticResource KeyboardFocus}" Content="เปิดโฟลเดอร์" Command="{Binding OpenFolderCommand, ElementName=Root}" CommandParameter="{Binding CommandParameter, ElementName=Root}" Margin="0,0,8,8"/>
  <ui:Button MinHeight="36" FocusVisualStyle="{StaticResource KeyboardFocus}" Content="ส่งต่อ" Visibility="{Binding HasTransferTargets, ElementName=Root, Converter={StaticResource BooleanToVisibilityConverter}}" Tag="{Binding ElementName=Root}" Click="ShowTransferMenu" Margin="0,0,0,8">
   <ui:Button.ContextMenu>
    <ContextMenu>
     <ContextMenu.Resources><Style TargetType="MenuItem"><Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Visibility" Value="Collapsed"/></Trigger><Trigger Property="Command" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></ContextMenu.Resources>
     <MenuItem Header="แปลงไฟล์" Command="{Binding PlacementTarget.Tag.SendToConverterCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.Tag.CommandParameter, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
     <MenuItem Header="ตัดวิดีโอ" Command="{Binding PlacementTarget.Tag.SendToVideoCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.Tag.CommandParameter, RelativeSource={RelativeSource AncestorType=ContextMenu}}" IsEnabled="{Binding PlacementTarget.Tag.CanSendVideo, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
     <MenuItem Header="ตัดเสียง" Command="{Binding PlacementTarget.Tag.SendToAudioCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.Tag.CommandParameter, RelativeSource={RelativeSource AncestorType=ContextMenu}}" IsEnabled="{Binding PlacementTarget.Tag.CanSendAudio, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
    </ContextMenu>
   </ui:Button.ContextMenu>
  </ui:Button>
 </WrapPanel>
</UserControl>
