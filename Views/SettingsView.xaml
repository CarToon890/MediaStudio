<UserControl x:Class="MediaStudio.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:viewmodels="clr-namespace:MediaStudio.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=viewmodels:SettingsViewModel}"
             d:DesignHeight="700" d:DesignWidth="900">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            <ui:TextBlock Text="การตั้งค่า" FontTypography="Title" />
            <ui:TextBlock Text="ตั้งค่าโฟลเดอร์บันทึกไฟล์ การเร่งความเร็วด้วยการ์ดจอ และเอนจินประมวลผล" 
                          Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" />
        </StackPanel>

        <!-- Settings Cards List -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- 1. Download Path Card -->
                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                        CornerRadius="8" Padding="20" BorderThickness="1" 
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Margin="0,0,0,16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,12">
                            <ui:TextBlock Text="โฟลเดอร์ปลายทางสำหรับบันทึกไฟล์ (Output Directory)" FontWeight="SemiBold" />
                            <ui:TextBlock Text="ไฟล์ที่ดาวน์โหลด แปลงไฟล์ หรือตัดคลิป จะถูกบันทึกไว้ในโฟลเดอร์นี้" 
                                          Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0" />
                        </StackPanel>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ui:TextBox Grid.Column="0" Text="{Binding DownloadPath, UpdateSourceTrigger=PropertyChanged}" 
                                        IsReadOnly="True" Margin="0,0,12,0" VerticalAlignment="Center" />

                            <ui:Button Grid.Column="1" Content="เลือกโฟลเดอร์..." Icon="{ui:SymbolIcon Symbol=FolderOpen24}" 
                                       Command="{Binding BrowseDownloadFolderCommand}" Margin="0,0,8,0" VerticalAlignment="Center" />

                            <ui:Button Grid.Column="2" Content="เปิดโฟลเดอร์" Icon="{ui:SymbolIcon Symbol=Open24}" 
                                       Command="{Binding OpenDownloadFolderCommand}" VerticalAlignment="Center" />
                        </Grid>
                    </Grid>
                </Border>

                <!-- 2. Hardware Acceleration Card -->
                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                        CornerRadius="8" Padding="20" BorderThickness="1" 
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <ui:TextBlock Text="ใช้การ์ดจอช่วยประมวลผล (NVIDIA NVENC)" FontWeight="SemiBold" />
                            <ui:TextBlock Text="ใช้การ์ดจอ NVIDIA ที่รองรับเพื่อเร่งการแปลงวิดีโอ หากใช้งานไม่ได้ระบบจะเปลี่ยนไปใช้ CPU"
                                          Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0" />
                        </StackPanel>

                        <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding EnableHardwareAcceleration}" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- 3. Engine Status Card -->
                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                        CornerRadius="8" Padding="20" BorderThickness="1" 
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <ui:TextBlock Text="สถานะเอนจินประมวลผล (yt-dlp &amp; FFmpeg)" FontWeight="SemiBold" />
                            <ui:TextBlock Text="{Binding EngineStatus}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0" />
                        </StackPanel>

                        <ui:Button Grid.Column="1" Content="{Binding EngineActionLabel}" Icon="{ui:SymbolIcon Symbol=ArrowSync24}"
                                   Command="{Binding UpdateEnginesCommand}" IsEnabled="{Binding IsUpdatingEngine, Converter={StaticResource InverseBooleanConverter}}" 
                                   VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- 4. About App Card -->
                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                        CornerRadius="8" Padding="20" BorderThickness="1" 
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                    <StackPanel>
                    <ui:TextBlock Text="{Binding AppVersion}" FontWeight="SemiBold" />
                        <ui:TextBlock Text="พัฒนาด้วย .NET 9.0, C#, WPF-UI Fluent Design, yt-dlp และ FFmpeg" 
                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
