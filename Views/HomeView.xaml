<UserControl x:Class="MediaStudio.Views.HomeView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <StackPanel Margin="28">
   <ui:TextBlock TextWrapping="Wrap" Text="ยินดีต้อนรับสู่ MediaStudio" FontTypography="Title"/>
   <ui:TextBlock Text="ดาวน์โหลด แปลง ตัดวิดีโอ และตัดเสียงได้จากที่เดียว ผลลัพธ์ทุกไฟล์จะเชื่อมต่อผ่านคลังงาน" Margin="0,6,0,18" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>



   <TextBlock Text="ระบบพร้อมใช้งาน เลือกเครื่องมือด้านล่างเพื่อเริ่มงาน" Style="{StaticResource SecondaryText}" Margin="0,0,0,16" Visibility="{Binding EnginesReady, Converter={StaticResource BooleanToVisibilityConverter}}"/>
   <Border Visibility="{Binding EnginesReady, Converter={StaticResource InverseBooleanToVisibilityConverter}}" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,18">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel><ui:TextBlock TextWrapping="Wrap" Text="{Binding EngineStatusTitle}" FontTypography="Subtitle"/><ui:TextBlock Text="{Binding AppStatus}" Margin="0,4,16,0" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/></StackPanel>
      <ui:Button MinHeight="36" FocusVisualStyle="{StaticResource KeyboardFocus}" Grid.Column="1" Content="{Binding EngineActionLabel}" Command="{Binding SetupEnginesCommand}" Appearance="Primary" IsEnabled="{Binding IsEngineInitializing, Converter={StaticResource InverseBooleanConverter}}" Visibility="{Binding ShowEngineAction, Converter={StaticResource BooleanToVisibilityConverter}}"/>
     </Grid>
     <ProgressBar Grid.Row="1" Value="{Binding EngineProgress}" Maximum="100" Height="6" Margin="0,12,0,0"/>
     <ui:TextBlock Grid.Row="2" Text="การดาวน์โหลดส่วนประกอบต้องใช้อินเทอร์เน็ตและพื้นที่ว่างประมาณ 150–250 MB ระบบจะถามยืนยันก่อนดาวน์โหลดทุกครั้ง" Margin="0,10,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
    </Grid>
   </Border>

   <ui:TextBlock TextWrapping="Wrap" Text="เลือกสิ่งที่ต้องการทำ" FontTypography="Subtitle" Margin="0,0,0,10"/>
   <UniformGrid Columns="2" Rows="2" Margin="-6,-6,-6,14">
    <ui:Button FocusVisualStyle="{StaticResource KeyboardFocus}" Command="{Binding NavigateCommand}" CommandParameter="Downloader" IsEnabled="{Binding EnginesReady}" Margin="6" Padding="18" MinHeight="112" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><ui:SymbolIcon Symbol="ArrowDownload24" FontSize="28" Margin="0,0,16,0"/><StackPanel Grid.Column="1"><ui:TextBlock TextWrapping="Wrap" Text="ดาวน์โหลดมีเดีย" FontTypography="Subtitle"/><ui:TextBlock Text="วางลิงก์ ตั้งชื่อ และดาวน์โหลดวิดีโอหรือเสียงจากเว็บไซต์ที่รองรับ" TextWrapping="Wrap" Margin="0,5,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/></StackPanel></Grid></ui:Button>
    <ui:Button FocusVisualStyle="{StaticResource KeyboardFocus}" Command="{Binding NavigateCommand}" CommandParameter="Converter" IsEnabled="{Binding EnginesReady}" Margin="6" Padding="18" MinHeight="112" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><ui:SymbolIcon Symbol="ArrowSync24" FontSize="28" Margin="0,0,16,0"/><StackPanel Grid.Column="1"><ui:TextBlock TextWrapping="Wrap" Text="แปลงและบีบอัด" FontTypography="Subtitle"/><ui:TextBlock Text="แปลงวิดีโอและเสียงเป็น MP4, MKV, MP3, WAV, FLAC หรือ GIF" TextWrapping="Wrap" Margin="0,5,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/></StackPanel></Grid></ui:Button>
    <ui:Button FocusVisualStyle="{StaticResource KeyboardFocus}" Command="{Binding NavigateCommand}" CommandParameter="Trimmer" IsEnabled="{Binding EnginesReady}" Margin="6" Padding="18" MinHeight="112" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><ui:SymbolIcon Symbol="Video24" FontSize="28" Margin="0,0,16,0"/><StackPanel Grid.Column="1"><ui:TextBlock TextWrapping="Wrap" Text="ตัดวิดีโอ" FontTypography="Subtitle"/><ui:TextBlock Text="เลือกช่วงและตัดอย่างรวดเร็วโดยรักษาคุณภาพวิดีโอต้นฉบับ" TextWrapping="Wrap" Margin="0,5,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/></StackPanel></Grid></ui:Button>
    <ui:Button FocusVisualStyle="{StaticResource KeyboardFocus}" Command="{Binding NavigateCommand}" CommandParameter="AudioTrimmer" IsEnabled="{Binding EnginesReady}" Margin="6" Padding="18" MinHeight="112" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><ui:SymbolIcon Symbol="Play24" FontSize="28" Margin="0,0,16,0"/><StackPanel Grid.Column="1"><ui:TextBlock TextWrapping="Wrap" Text="ตัดและปรับเสียง" FontTypography="Subtitle"/><ui:TextBlock Text="ดูคลื่นเสียง เลือกช่วง ปรับความดัง และดึงเสียงจากวิดีโอ" TextWrapping="Wrap" Margin="0,5,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/></StackPanel></Grid></ui:Button>
   </UniformGrid>

   <Grid Margin="0,4,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ui:TextBlock TextWrapping="Wrap" Text="งานล่าสุด" FontTypography="Subtitle"/><ui:Button MinHeight="36" FocusVisualStyle="{StaticResource KeyboardFocus}" Grid.Column="1" Content="เปิดคลังงาน" Command="{Binding NavigateCommand}" CommandParameter="Workspace"/></Grid>
   <Grid>
    <ui:TextBlock TextWrapping="Wrap" Text="ยังไม่มีงานล่าสุด เมื่อสร้างหรือเปิดไฟล์ รายการจะแสดงที่นี่" HorizontalAlignment="Center" Margin="0,28" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Visibility="{Binding WorkspaceVm.HasAssets, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
    <ListBox ItemsSource="{Binding WorkspaceVm.Assets}" MaxHeight="210" Background="Transparent" BorderThickness="0">
     <ListBox.ItemTemplate><DataTemplate><Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="6" Padding="10" Margin="0,0,0,6"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><ui:TextBlock TextWrapping="Wrap" Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><ui:TextBlock TextWrapping="Wrap" Text="{Binding SourceTool, StringFormat='ที่มา: {0}'}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/></StackPanel><ui:TextBlock TextWrapping="Wrap" Grid.Column="1" Text="{Binding KindLabel}" VerticalAlignment="Center"/></Grid></Border></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
   </Grid>
   <Expander Header="วิธีใช้ MediaStudio" Margin="0,16,0,16" IsExpanded="{Binding EnginesReady, Converter={StaticResource InverseBooleanConverter}, Mode=OneWay}">
    <UniformGrid Columns="3">
     <StackPanel Margin="8"><ui:TextBlock TextWrapping="Wrap" Text="1  เตรียมระบบ" FontWeight="SemiBold"/><ui:TextBlock Text="ดาวน์โหลดส่วนประกอบที่จำเป็นในครั้งแรก" TextWrapping="Wrap" Margin="0,4,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/></StackPanel>
     <StackPanel Margin="8"><ui:TextBlock TextWrapping="Wrap" Text="2  เลือกเครื่องมือ" FontWeight="SemiBold"/><ui:TextBlock Text="เลือกงานจากการ์ดด้านล่างแล้วเพิ่มไฟล์หรือลิงก์" TextWrapping="Wrap" Margin="0,4,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/></StackPanel>
     <StackPanel Margin="8"><ui:TextBlock TextWrapping="Wrap" Text="3  ใช้งานผลลัพธ์ต่อ" FontWeight="SemiBold"/><ui:TextBlock Text="เปิดไฟล์หรือส่งต่อจากคลังงานโดยไม่ต้องเลือกใหม่" TextWrapping="Wrap" Margin="0,4,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/></StackPanel>
    </UniformGrid>
   </Expander>
  </StackPanel>
 </ScrollViewer>
</UserControl>
