<UserControl x:Class="MediaStudio.Views.HomeView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
 <ScrollViewer VerticalScrollBarVisibility="Auto">
  <StackPanel Margin="28">
   <ui:TextBlock Text="ยินดีต้อนรับสู่ MediaStudio" FontTypography="Title" />
   <ui:TextBlock Text="เลือกสิ่งที่ต้องการทำ ระบบจะส่งไฟล์ต่อระหว่างเครื่องมือให้โดยไม่ต้องเลือกใหม่" Margin="0,6,0,20" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
   <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,18">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel><ui:TextBlock Text="สถานะเอนจินประมวลผล" FontWeight="SemiBold"/><ui:TextBlock Text="{Binding AppStatus}" Margin="0,4,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/></StackPanel>
      <ui:Button Grid.Column="1" Content="ลองใหม่" Command="{Binding RetryEnginesCommand}" IsEnabled="{Binding IsEngineInitializing, Converter={StaticResource InverseBooleanConverter}}"/>
     </Grid>
     <ProgressBar Grid.Row="1" Value="{Binding EngineProgress}" Maximum="100" Height="6" Margin="0,12,0,0"/>
    </Grid>
   </Border>
   <UniformGrid Columns="2" Margin="0,0,0,20">
    <ui:Button Command="{Binding NavigateCommand}" CommandParameter="Downloader" IsEnabled="{Binding EnginesReady}" Margin="0,0,8,8" Padding="18" HorizontalContentAlignment="Left"><StackPanel><ui:TextBlock Text="ดาวน์โหลดมีเดีย" FontTypography="Subtitle"/><ui:TextBlock Text="วางลิงก์ ตั้งชื่อไฟล์ และดาวน์โหลดวิดีโอหรือเสียง" Margin="0,5,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/></StackPanel></ui:Button>
    <ui:Button Command="{Binding NavigateCommand}" CommandParameter="Converter" IsEnabled="{Binding EnginesReady}" Margin="8,0,0,8" Padding="18" HorizontalContentAlignment="Left"><StackPanel><ui:TextBlock Text="แปลงและบีบอัด" FontTypography="Subtitle"/><ui:TextBlock Text="แปลงวิดีโอ เสียง และลดขนาดไฟล์" Margin="0,5,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/></StackPanel></ui:Button>
    <ui:Button Command="{Binding NavigateCommand}" CommandParameter="Trimmer" IsEnabled="{Binding EnginesReady}" Margin="0,8,8,0" Padding="18" HorizontalContentAlignment="Left"><StackPanel><ui:TextBlock Text="ตัดวิดีโอ" FontTypography="Subtitle"/><ui:TextBlock Text="เลือกช่วงคลิปและตัดแบบไม่เข้ารหัสใหม่" Margin="0,5,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/></StackPanel></ui:Button>
    <ui:Button Command="{Binding NavigateCommand}" CommandParameter="AudioTrimmer" IsEnabled="{Binding EnginesReady}" Margin="8,8,0,0" Padding="18" HorizontalContentAlignment="Left"><StackPanel><ui:TextBlock Text="ตัดเสียง" FontTypography="Subtitle"/><ui:TextBlock Text="ดูคลื่นเสียงและตัดจากไฟล์เสียงหรือวิดีโอ" Margin="0,5,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/></StackPanel></ui:Button>
   </UniformGrid>
   <Grid Margin="0,4,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ui:TextBlock Text="งานล่าสุด" FontTypography="Subtitle"/><ui:Button Grid.Column="1" Content="เปิดคลังงาน" Command="{Binding NavigateCommand}" CommandParameter="Workspace"/></Grid>
   <ListBox ItemsSource="{Binding WorkspaceVm.Assets}" MaxHeight="210" Background="Transparent" BorderThickness="0">
    <ListBox.ItemTemplate><DataTemplate><Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="6" Padding="10" Margin="0,0,0,6"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><ui:TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><ui:TextBlock Text="{Binding SourceTool, StringFormat='ที่มา: {0}'}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/></StackPanel><ui:TextBlock Grid.Column="1" Text="{Binding KindLabel}" VerticalAlignment="Center"/></Grid></Border></DataTemplate></ListBox.ItemTemplate>
   </ListBox>
  </StackPanel>
 </ScrollViewer>
</UserControl>
