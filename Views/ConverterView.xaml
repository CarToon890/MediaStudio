<UserControl x:Class="MediaStudio.Views.ConverterView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:views="clr-namespace:MediaStudio.Views" AllowDrop="True" Drop="UserControl_Drop" PreviewDragOver="UserControl_PreviewDragOver">
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="24">
<TextBlock Text="แปลงและบีบอัดไฟล์" Style="{StaticResource PageTitle}"/>
 <TextBlock Text="เลือกไฟล์ ตั้งรูปแบบผลลัพธ์ แล้วเริ่มแปลงเป็นชุด" Margin="0,0,0,16"/>
 <Expander Header="วิธีใช้" Margin="0,0,0,16"><TextBlock Text="เพิ่มไฟล์หรือลากมาวาง เลือกรูปแบบและปลายทาง โหมดบีบอัดใช้ได้กับ MP4/MKV เท่านั้น ขนาดจริงอาจต่างจากเป้าหมาย ไฟล์ที่เพิ่มระหว่างทำงานจะรอชุดถัดไป" TextWrapping="Wrap" Margin="0,8,0,0"/></Expander>
 <Border Style="{StaticResource Surface}"><StackPanel>
  <TextBlock Text="{Binding InputContext}" Style="{StaticResource SecondaryText}" Margin="0,0,0,8"/>
  <WrapPanel><ui:Button MinHeight="36" FocusVisualStyle="{StaticResource KeyboardFocus}" Content="เพิ่มไฟล์…" Command="{Binding SelectFilesCommand}" Margin="0,0,16,8"/><StackPanel Margin="0,0,0,8"><TextBlock Text="รูปแบบผลลัพธ์"/><ComboBox ItemsSource="{Binding TargetFormats}" SelectedItem="{Binding SelectedTargetFormat}" MinWidth="160" AutomationProperties.Name="รูปแบบผลลัพธ์"/></StackPanel></WrapPanel>
  <CheckBox Content="บีบอัดวิดีโอ (MP4 / MKV)" IsChecked="{Binding IsCompressEnabled}" IsEnabled="{Binding CanCompressVideo}" Margin="0,8,0,0"/>
  <StackPanel Margin="0,12,0,0" Visibility="{Binding IsCompressEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
   <TextBlock Text="{Binding TargetSizeMb, StringFormat='ขนาดเป้าหมาย {0} MB'}" FontWeight="SemiBold"/>
   <Slider Minimum="5" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding TargetSizeMb}" AutomationProperties.Name="ขนาดเป้าหมายเป็นเมกะไบต์"/>
   <TextBlock Text="ขนาดเป็นค่าประมาณ คุณภาพอาจลดลงเมื่อเลือกไฟล์เล็ก" Style="{StaticResource SecondaryText}"/>
  </StackPanel>
<views:OutputLocationView DataContext="{Binding DataContext.OutputLocation, RelativeSource={RelativeSource AncestorType=Window}}"/>
  <WrapPanel><ui:Button MinHeight="36" FocusVisualStyle="{StaticResource KeyboardFocus}" Content="เริ่มแปลงทั้งหมด" Appearance="Primary" Command="{Binding StartConversionCommand}" Margin="0,0,8,8"/><ui:Button MinHeight="36" FocusVisualStyle="{StaticResource KeyboardFocus}" Content="ยกเลิกทั้งหมด" Appearance="Danger" Command="{Binding CancelAllCommand}" Visibility="{Binding IsConverting, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,8,8"/><ui:Button MinHeight="36" FocusVisualStyle="{StaticResource KeyboardFocus}" Content="ล้างงานที่เสร็จ" Command="{Binding ClearCompletedCommand}" Margin="0,0,0,8"/></WrapPanel>
  <TextBlock Text="ค่าที่เปลี่ยนขณะทำงานจะใช้กับชุดถัดไป" Style="{StaticResource SecondaryText}" Margin="0,8,0,0" Visibility="{Binding IsConverting, Converter={StaticResource BooleanToVisibilityConverter}}"/>
  <TextBlock Text="{Binding StatusText}" Style="{StaticResource SecondaryText}" AutomationProperties.LiveSetting="Polite"/>
 </StackPanel></Border>
<Border Style="{StaticResource Surface}"><StackPanel><TextBlock Text="คิวการแปลงไฟล์" Style="{StaticResource SectionTitle}"/><TextBlock Text="ยังไม่มีไฟล์ในคิว เพิ่มไฟล์หรือลากมาวางในหน้านี้" Margin="0,16" TextWrapping="Wrap" Visibility="{Binding HasConversionItems, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>                <ListBox  ItemsSource="{Binding ConversionList}" Background="Transparent" BorderThickness="0" MaxHeight="560" ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- File Info -->
                                    <StackPanel Grid.Row="0" Grid.Column="0">
                                        <ui:TextBlock TextWrapping="Wrap" Text="{Binding FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <WrapPanel Margin="0,2,0,0">
                                            <ui:TextBlock TextWrapping="Wrap" Text="{Binding FileSizeFormatted, StringFormat='ขนาดต้นฉบับ: {0} | '}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <ui:TextBlock TextWrapping="Wrap" Text="{Binding TargetFormat, StringFormat='แปลงเป็น: {0}'}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <ui:TextBlock TextWrapping="Wrap" Text="{Binding StatusMessage, StringFormat=' - {0}'}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </WrapPanel>
                                    </StackPanel>

                                    <!-- Actions -->
<StackPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,12,0,0">
 <TextBlock Text="{Binding OutputPath}" Style="{StaticResource SecondaryText}" Margin="0,0,0,8" Visibility="{Binding IsCompleted, Converter={StaticResource BooleanToVisibilityConverter}}"/>
 <views:ResultActionsView OpenFileCommand="{Binding DataContext.PlayItemCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" OpenFolderCommand="{Binding DataContext.OpenOutputFolderCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" SendToVideoCommand="{Binding DataContext.SendToVideoTrimmerCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" SendToAudioCommand="{Binding DataContext.SendToAudioTrimmerCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" CanSendVideo="{Binding CanOpenOutputInVideoTrimmer}" CanSendAudio="{Binding CanOpenOutputInAudioTrimmer}" Visibility="{Binding IsCompleted, Converter={StaticResource BooleanToVisibilityConverter}}"/>
 <WrapPanel><ui:Button MinHeight="36" FocusVisualStyle="{StaticResource KeyboardFocus}" Content="ยกเลิก" Appearance="Danger" Command="{Binding DataContext.CancelTaskCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" Margin="0,0,8,0" Visibility="{Binding IsRunning, Converter={StaticResource BooleanToVisibilityConverter}}"/><ui:Button MinHeight="36" FocusVisualStyle="{StaticResource KeyboardFocus}" Content="ลบออกจากคิว" Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"/></WrapPanel>
</StackPanel>

                                    <!-- Progress -->
                                    <ProgressBar Grid.Row="2" Grid.ColumnSpan="3" Value="{Binding Progress}" Maximum="100" Height="6" Margin="0,8,0,0" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox></StackPanel></Border>
 </StackPanel></ScrollViewer>
</UserControl>
