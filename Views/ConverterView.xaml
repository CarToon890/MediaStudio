<UserControl x:Class="MediaStudio.Views.ConverterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:viewmodels="clr-namespace:MediaStudio.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=viewmodels:ConverterViewModel}"
             d:DesignHeight="700" d:DesignWidth="900"
             AllowDrop="True" Drop="UserControl_Drop" PreviewDragOver="UserControl_PreviewDragOver">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <ui:TextBlock Text="Media Converter &amp; Compressor" FontTypography="Title" />
            <ui:TextBlock Text="แปลงฟอร์แมตวิดีโอ/เพลง (MP4, MP3, GIF, WAV) และบีบอัดลดขนาดไฟล์สำหรับ Discord/LINE" 
                          Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" />
        </StackPanel>

        <!-- Controls & Options Card -->
        <Border Grid.Row="1" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                CornerRadius="8" Padding="16" Margin="0,0,0,16" BorderThickness="1" 
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Top row: Select File, Target Format, Convert Button -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ui:Button Grid.Column="0" Content="เลือกไฟล์มีเดีย..." Icon="{ui:SymbolIcon Symbol=Add24}" 
                               Appearance="Primary" Command="{Binding SelectFilesCommand}" Margin="0,0,16,0" VerticalAlignment="Center" />

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                        <ui:TextBlock Text="แปลงเป็น:" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ComboBox ItemsSource="{Binding TargetFormats}" SelectedItem="{Binding SelectedTargetFormat}" Width="100" />
                    </StackPanel>

                    <ui:TextBlock Grid.Column="2" Text="{Binding StatusText}" VerticalAlignment="Center" 
                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />

                    <ui:Button Grid.Column="3" Content="ล้างรายการที่เสร็จแล้ว" Icon="{ui:SymbolIcon Symbol=Delete24}" 
                               Command="{Binding ClearCompletedCommand}" Margin="0,0,8,0" VerticalAlignment="Center" />

                    <ui:Button Grid.Column="4" Content="เริ่มแปลงไฟล์ทั้งหมด" Appearance="Success" Icon="{ui:SymbolIcon Symbol=Play24}" 
                               Command="{Binding StartConversionCommand}" 
                               Visibility="{Binding IsConverting, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                               VerticalAlignment="Center" />

                    <ui:Button Grid.Column="4" Content="ยกเลิกทั้งหมด" Appearance="Danger" Icon="{ui:SymbolIcon Symbol=Stop24}" 
                               Command="{Binding CancelAllCommand}" 
                               Visibility="{Binding IsConverting, Converter={StaticResource BooleanToVisibilityConverter}}"
                               VerticalAlignment="Center" />
                </Grid>

                <!-- Bottom row: Compression Settings -->
                <Border Grid.Row="1" Background="{DynamicResource ControlFillColorDefaultBrush}" 
                        CornerRadius="6" Padding="12" Margin="0,12,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <CheckBox Grid.Column="0" Content="โหมดบีบอัดไฟล์วิดีโอ (Compress for Discord / LINE)" 
                                  IsEnabled="{Binding CanCompressVideo}"
                                  IsChecked="{Binding IsCompressEnabled}" VerticalAlignment="Center" Margin="0,0,16,0" />

                        <ui:TextBlock Grid.Column="1" Text="ขนาดเป้าหมาย:" VerticalAlignment="Center" 
                                      IsEnabled="{Binding IsCompressEnabled}" Margin="0,0,8,0" />

                        <Slider Grid.Column="2" Minimum="5" Maximum="100" Value="{Binding TargetSizeMb}" 
                                TickFrequency="5" IsSnapToTickEnabled="True" IsEnabled="{Binding IsCompressEnabled}" 
                                VerticalAlignment="Center" Margin="0,0,12,0" />

                        <ui:TextBlock Grid.Column="3" Text="{Binding TargetSizeMb, StringFormat='&lt; {0} MB'}" 
                                      FontWeight="Bold" VerticalAlignment="Center" IsEnabled="{Binding IsCompressEnabled}" />
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Conversion Queue -->
        <Border Grid.Row="2" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                CornerRadius="8" Padding="16" BorderThickness="1" 
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <ui:TextBlock Text="คิวการแปลงไฟล์ (สามารถลากไฟล์มาวางในหน้านี้ได้เลย)" FontTypography="Subtitle" />
                </Grid>

                <ListBox Grid.Row="1" ItemsSource="{Binding ConversionList}" Background="Transparent" BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- File Info -->
                                    <StackPanel Grid.Row="0" Grid.Column="0">
                                        <ui:TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                            <ui:TextBlock Text="{Binding FileSizeFormatted, StringFormat='ขนาดต้นฉบับ: {0} | '}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <ui:TextBlock Text="{Binding TargetFormat, StringFormat='แปลงเป็น: {0}'}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <ui:TextBlock Text="{Binding StatusMessage, StringFormat=' - {0}'}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Actions -->
                                    <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal">
                                        <ui:Button Icon="{ui:SymbolIcon Symbol=Play24}" ToolTip="เปิดเล่นไฟล์ทันที" 
                                                   Appearance="Primary"
                                                   Command="{Binding DataContext.PlayItemCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" 
                                                   CommandParameter="{Binding}" Margin="0,0,4,0"
                                                   Visibility="{Binding IsCompleted, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        <ui:Button Icon="{ui:SymbolIcon Symbol=Stop24}" ToolTip="ยกเลิกการแปลงไฟล์" 
                                                   Appearance="Danger"
                                                   Command="{Binding DataContext.CancelTaskCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" 
                                                   CommandParameter="{Binding}" Margin="0,0,4,0"
                                                   Visibility="{Binding IsRunning, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        <ui:Button Icon="{ui:SymbolIcon Symbol=FolderOpen24}" ToolTip="เปิดโฟลเดอร์" 
                                                   Command="{Binding DataContext.OpenOutputFolderCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" 
                                                   CommandParameter="{Binding}" Margin="0,0,4,0" />
                                        <ui:Button Icon="{ui:SymbolIcon Symbol=Dismiss24}" ToolTip="ลบออกจากคิว" 
                                                   Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" 
                                                   CommandParameter="{Binding}" />
                                    </StackPanel>

                                    <!-- Progress -->
                                    <ProgressBar Grid.Row="1" Grid.ColumnSpan="3" Value="{Binding Progress}" Maximum="100" Height="6" Margin="0,8,0,0" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
    </Grid>
</UserControl>
