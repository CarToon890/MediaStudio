<UserControl x:Class="MediaStudio.Views.DownloaderView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:views="clr-namespace:MediaStudio.Views">
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="24">
<TextBlock Text="ดาวน์โหลดมีเดีย" Style="{StaticResource PageTitle}"/>
 <TextBlock Text="วางลิงก์ ตรวจชื่อและคุณภาพ แล้วดาวน์โหลดไปยังโฟลเดอร์ที่เลือก" Margin="0,0,0,16"/>
 <Expander Header="วิธีใช้" Margin="0,0,0,16"><TextBlock Text="วางลิงก์แล้วดึงข้อมูล เลือกวิดีโอหรือ MP3 ตรวจชื่อและปลายทางก่อนเริ่ม งานที่เสร็จแล้วเปิดหรือส่งต่อได้จากคิว" TextWrapping="Wrap" Margin="0,8,0,0"/></Expander>
 <Border Style="{StaticResource Surface}"><StackPanel>
  <TextBlock Text="1. วางลิงก์" Style="{StaticResource SectionTitle}"/>
  <ui:TextBox x:Name="UrlTextBox" Text="{Binding UrlInput, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="ลิงก์วิดีโอ" PlaceholderText="https://…"><ui:TextBox.InputBindings><KeyBinding Key="Return" Command="{Binding FetchInfoCommand}"/></ui:TextBox.InputBindings></ui:TextBox>
  <TextBlock Text="{Binding UrlError}" Margin="0,8,0,0" Visibility="{Binding HasUrlError, Converter={StaticResource BooleanToVisibilityConverter}}" AutomationProperties.LiveSetting="Polite"/>
  <WrapPanel Margin="0,12,0,0"><ui:Button MinHeight="36" FocusVisualStyle="{StaticResource KeyboardFocus}" Content="วางลิงก์" Command="{Binding PasteClipboardCommand}" Margin="0,0,8,0"/><ui:Button MinHeight="36" FocusVisualStyle="{StaticResource KeyboardFocus}" Content="ดึงข้อมูล" Appearance="Primary" Command="{Binding FetchInfoCommand}"/></WrapPanel>
  <ProgressBar IsIndeterminate="True" Height="4" Margin="0,12,0,0" Visibility="{Binding IsLoadingInfo, Converter={StaticResource BooleanToVisibilityConverter}}"/>
  <TextBlock Text="{Binding StatusText}" Style="{StaticResource SecondaryText}" Margin="0,12,0,0" AutomationProperties.LiveSetting="Polite"/>
 </StackPanel></Border>
 <Border x:Name="ReviewPanel" Style="{StaticResource Surface}" Visibility="{Binding HasMediaInfo, Converter={StaticResource BooleanToVisibilityConverter}}"><StackPanel>
  <TextBlock Text="2. ตรวจชื่อ คุณภาพ และปลายทาง" Style="{StaticResource SectionTitle}"/>
  <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Image Source="{Binding CurrentMediaInfo.ThumbnailUrl}" Width="96" Height="54" Stretch="UniformToFill" Margin="0,0,16,0" AutomationProperties.Name="ภาพตัวอย่างสื่อ" Visibility="{Binding HasThumbnail, Converter={StaticResource BooleanToVisibilityConverter}}"/>
   <StackPanel Grid.Column="1"><TextBlock Text="{Binding CurrentMediaInfo.Title}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
    <TextBlock Text="{Binding CurrentMediaInfo.Author, StringFormat='ผู้สร้าง: {0}'}" Style="{StaticResource SecondaryText}" Visibility="{Binding HasAuthor, Converter={StaticResource BooleanToVisibilityConverter}}"/>
    <TextBlock Text="{Binding CurrentMediaInfo.DurationFormatted, StringFormat='ความยาว {0}'}" Style="{StaticResource SecondaryText}" Margin="0,4,0,0"/>
   </StackPanel>
  </Grid>
  <TextBlock Text="ชื่อไฟล์ที่จะบันทึก"/><ui:TextBox x:Name="FileNameTextBox" Text="{Binding OutputFileName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="ชื่อไฟล์ที่จะบันทึก"/>
  <TextBlock Text="{Binding FileNameError}" Margin="0,4,0,0" Visibility="{Binding HasFileNameError, Converter={StaticResource BooleanToVisibilityConverter}}"/>
  <WrapPanel Margin="0,12,0,0">
   <StackPanel Margin="0,0,16,8" Visibility="{Binding IsAudioOnly, Converter={StaticResource InverseBooleanToVisibilityConverter}}"><TextBlock Text="ความละเอียด"/><ComboBox ItemsSource="{Binding QualityOptions}" SelectedItem="{Binding SelectedQuality}" MinWidth="160" AutomationProperties.Name="ความละเอียดวิดีโอ"/></StackPanel>
   <CheckBox Content="ดาวน์โหลดเฉพาะเสียง (MP3)" IsChecked="{Binding IsAudioOnly}" VerticalAlignment="Center" Margin="0,0,0,8"/>
  </WrapPanel>
  <TextBlock Text="{Binding OutputExtension, StringFormat='นามสกุลผลลัพธ์: {0}'}" Style="{StaticResource SecondaryText}"/>
<views:OutputLocationView DataContext="{Binding DataContext.OutputLocation, RelativeSource={RelativeSource AncestorType=Window}}"/>
  <TextBlock Text="3. เริ่มดาวน์โหลด" FontWeight="SemiBold" Margin="0,4,0,8"/>
  <ui:Button MinHeight="36" FocusVisualStyle="{StaticResource KeyboardFocus}" Content="เริ่มดาวน์โหลด" Appearance="Primary" Command="{Binding StartDownloadCommand}" HorizontalAlignment="Left"/>
 </StackPanel></Border>
<Border Style="{StaticResource Surface}"><StackPanel><TextBlock Text="คิวและประวัติการดาวน์โหลด" Style="{StaticResource SectionTitle}"/><TextBlock Text="ยังไม่มีรายการดาวน์โหลด เริ่มด้วยการวางลิงก์ด้านบน" Margin="0,16" TextWrapping="Wrap" Visibility="{Binding HasDownloadItems, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>                <ListBox  ItemsSource="{Binding DownloadQueue}" Background="Transparent" BorderThickness="0" MaxHeight="560" ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Title & Stats -->
                                    <StackPanel Grid.Row="0" Grid.Column="0">
                                        <ui:TextBlock TextWrapping="Wrap" Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <ui:TextBlock TextWrapping="Wrap" Text="{Binding StatusMessage}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0" />
                                    </StackPanel>

                                    <!-- Actions -->
<StackPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,12,0,0">
 <TextBlock Text="{Binding OutputPath}" Style="{StaticResource SecondaryText}" Margin="0,0,0,8" Visibility="{Binding IsCompleted, Converter={StaticResource BooleanToVisibilityConverter}}"/>
 <views:ResultActionsView OpenFileCommand="{Binding DataContext.PlayItemCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" OpenFolderCommand="{Binding DataContext.OpenOutputFolderCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" SendToConverterCommand="{Binding DataContext.SendToConverterCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" SendToVideoCommand="{Binding DataContext.SendToVideoTrimmerCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" SendToAudioCommand="{Binding DataContext.SendToAudioTrimmerCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" CanSendVideo="{Binding CanSendToVideoTrimmer}" CanSendAudio="{Binding IsCompleted}" Visibility="{Binding IsCompleted, Converter={StaticResource BooleanToVisibilityConverter}}"/>
 <WrapPanel><ui:Button MinHeight="36" FocusVisualStyle="{StaticResource KeyboardFocus}" Content="ยกเลิก" Appearance="Danger" Command="{Binding DataContext.CancelTaskCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" Margin="0,0,8,0" Visibility="{Binding IsRunning, Converter={StaticResource BooleanToVisibilityConverter}}"/><ui:Button MinHeight="36" FocusVisualStyle="{StaticResource KeyboardFocus}" Content="ลบออกจากคิว" Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"/></WrapPanel>
</StackPanel>

                                    <!-- Progress Bar -->
                                    <ProgressBar Grid.Row="2" Grid.ColumnSpan="2" Value="{Binding Progress}" Maximum="100" Height="6" Margin="0,8,0,0" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox></StackPanel></Border>
 </StackPanel></ScrollViewer>
</UserControl>
