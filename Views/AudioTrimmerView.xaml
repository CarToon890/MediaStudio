<UserControl x:Class="MediaStudio.Views.AudioTrimmerView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
 <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,18"><ui:TextBlock Text="ตัดเสียง" FontTypography="Title"/><ui:TextBlock Text="ดูคลื่นเสียงและเลือกช่วงที่ต้องการจากไฟล์เสียงหรือวิดีโอ" Margin="0,4,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/></StackPanel>
  <Border Grid.Row="1" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><ui:TextBlock Text="{Binding FileName}" FontTypography="Subtitle"/><ui:TextBlock Text="{Binding StatusText}" Margin="0,4,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/></StackPanel><ui:Button Grid.Column="1" Content="เลือกไฟล์เสียงหรือวิดีโอ..." Command="{Binding SelectFileCommand}" Appearance="Primary" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"/></Grid></Border>
  <Border Grid.Row="2" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="210"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ui:TextBlock Text="คลื่นเสียงและช่วงที่เลือก" FontWeight="SemiBold"/><StackPanel Grid.Column="1" Orientation="Horizontal"><ui:TextBlock Text="ซูม" VerticalAlignment="Center" Margin="0,0,8,0"/><Slider x:Name="ZoomSlider" Minimum="1" Maximum="5" Value="1" Width="120" ValueChanged="ZoomSlider_ValueChanged"/></StackPanel></Grid>
   <ScrollViewer Grid.Row="1" x:Name="WaveformScroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,10"><Grid x:Name="WaveformHost" MinWidth="600" Background="#151515" ClipToBounds="True"><Canvas x:Name="WaveformCanvas" Height="190"/><Slider Minimum="0" Maximum="{Binding TotalSeconds}" Value="{Binding StartSeconds}" VerticalAlignment="Top" Margin="0,4,0,0"/><Slider Minimum="0" Maximum="{Binding TotalSeconds}" Value="{Binding EndSeconds}" VerticalAlignment="Bottom" Margin="0,0,0,4"/></Grid></ScrollViewer>
   <Grid Grid.Row="2" Margin="0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <StackPanel Grid.Column="0" Margin="0,0,8,0"><ui:TextBlock Text="เวลาเริ่ม (วินาที)"/><TextBox Text="{Binding StartSeconds, UpdateSourceTrigger=PropertyChanged, StringFormat=F3}"/></StackPanel>
    <StackPanel Grid.Column="1" Margin="8,0"><ui:TextBlock Text="เวลาสิ้นสุด (วินาที)"/><TextBox Text="{Binding EndSeconds, UpdateSourceTrigger=PropertyChanged, StringFormat=F3}"/></StackPanel>
    <StackPanel Grid.Column="2" Margin="8,0"><ui:TextBlock Text="ความยาวช่วง"/><ui:TextBlock Text="{Binding SelectionDurationFormatted}" FontWeight="SemiBold" Margin="0,8,0,0"/></StackPanel>
    <StackPanel Grid.Column="3" Margin="8,0,0,0"><ui:TextBlock Text="รูปแบบผลลัพธ์"/><ComboBox ItemsSource="{Binding OutputFormats}" SelectedItem="{Binding SelectedOutputFormat}"/></StackPanel>
   </Grid>
   <Grid Grid.Row="3" Margin="0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ui:Button Content="เล่น / หยุด" Command="{Binding TogglePlayCommand}" IsEnabled="{Binding HasLoadedFile}" Margin="0,0,6,0"/><ui:Button Grid.Column="1" Content="ตั้งเป็นจุดเริ่ม" Command="{Binding SetStartToCurrentCommand}" Margin="0,0,6,0"/><ui:Button Grid.Column="2" Content="ตั้งเป็นจุดสิ้นสุด" Command="{Binding SetEndToCurrentCommand}"/><ui:TextBlock Grid.Column="3" Text="{Binding CurrentTimeFormatted, StringFormat='ตำแหน่งปัจจุบัน: {0}'}" VerticalAlignment="Center" HorizontalAlignment="Center"/><ui:Button Grid.Column="4" Content="เริ่มตัดเสียง" Command="{Binding StartTrimCommand}" Appearance="Success" IsEnabled="{Binding HasLoadedFile}"/></Grid>
   <Border Grid.Row="4" Visibility="{Binding HasOutput, Converter={StaticResource BooleanToVisibilityConverter}}" Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="6" Padding="10" Margin="0,8,0,0"><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><ui:Button Content="เปิดผลลัพธ์" Command="{Binding OpenOutputCommand}" Margin="0,0,6,0"/><ui:Button Content="เปิดโฟลเดอร์" Command="{Binding OpenOutputFolderCommand}" Margin="0,0,6,0"/><ui:Button Content="ส่งไปแปลงไฟล์" Command="{Binding SendToConverterCommand}" Appearance="Primary"/></StackPanel></Border>
  </Grid></Border>
 </Grid>
</UserControl>
