<UserControl x:Class="MediaStudio.Views.TrimmerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:views="clr-namespace:MediaStudio.Views"
             xmlns:viewmodels="clr-namespace:MediaStudio.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=viewmodels:TrimmerViewModel}"
             d:DesignHeight="700" d:DesignWidth="900">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="ตัดวิดีโอ" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="{Binding InputContext}" Style="{StaticResource SecondaryText}" Margin="0,0,0,8"/>
            <Expander Header="วิธีใช้" Margin="0,0,0,8"><TextBlock Text="เลือกไฟล์ เลือกช่วงเริ่มและสิ้นสุด แล้วตรวจโฟลเดอร์ก่อนตัด การตัดแบบไม่เข้ารหัสใหม่อาจคลาดจากจุดที่เลือกตาม keyframe" TextWrapping="Wrap" Margin="0,8,0,0"/></Expander>
            <ui:TextBlock TextWrapping="Wrap" Text="เลือกช่วงและตัดวิดีโอแบบไม่เข้ารหัสใหม่ ระยะเวลาขึ้นอยู่กับขนาดไฟล์"
                          Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" />
        </StackPanel>

        <!-- File Selection Card -->
        <Border Grid.Row="1" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                CornerRadius="8" Padding="16" Margin="0,0,0,16" BorderThickness="1"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <ui:TextBlock TextWrapping="Wrap" Text="{Binding FileName, TargetNullValue='ยังไม่ได้เลือกไฟล์วิดีโอ', FallbackValue='ยังไม่ได้เลือกไฟล์วิดีโอ'}"
                                  FontTypography="Subtitle" TextTrimming="CharacterEllipsis" />
                    <ui:TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" />
                </StackPanel>

                <ui:Button MinHeight="36" FocusVisualStyle="{StaticResource KeyboardFocus}" Grid.Column="1" Content="เลือกไฟล์วิดีโอ..." Icon="{ui:SymbolIcon Symbol=FolderOpen24}"
                           Appearance="Primary" Command="{Binding SelectFileCommand}" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- Main Trimmer Area -->
        <views:ResponsiveColumnsPanel Grid.Row="2">

            <!-- Left Column: Video Preview Player & Player Controls -->
            <Border Grid.Column="0" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="8" Padding="16" BorderThickness="1"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="220" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ui:TextBlock TextWrapping="Wrap" Grid.Row="0" Text="ตัวอย่างวิดีโอ" FontWeight="SemiBold" Margin="0,0,0,10" />

                    <!-- Player Screen -->
                    <Border Grid.Row="1" Background="#0A0A0A" CornerRadius="6" ClipToBounds="True">
                        <Grid>
                            <MediaElement x:Name="PreviewPlayer"
                                          Source="{Binding SourceFilePath}"
                                          LoadedBehavior="Manual"
                                          ScrubbingEnabled="True"
                                          MediaOpened="PreviewPlayer_MediaOpened"
                                          MediaEnded="PreviewPlayer_MediaEnded"
                                          Stretch="Uniform" />

                            <!-- Placeholder if no file loaded -->
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Visibility="{Binding HasLoadedFile, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                <ui:SymbolIcon Symbol="Video24" FontSize="36" Foreground="{DynamicResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
                                <ui:TextBlock TextWrapping="Wrap" Text="เลือกไฟล์เพื่อรับชมตัวอย่าง" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,8,0,0" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Player Controls Bar -->
                    <StackPanel Grid.Row="2" Margin="0,12,0,0">
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Play/Pause Toggle -->
                            <ui:Button MinHeight="36" FocusVisualStyle="{StaticResource KeyboardFocus}" Grid.Column="0" Command="{Binding TogglePlayCommand}"
                                       IsEnabled="{Binding CanEdit}" Padding="12,6" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Play24" Margin="0,0,4,0"
                                                   Visibility="{Binding IsPlaying, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                                    <ui:SymbolIcon Symbol="Pause24" Margin="0,0,4,0"
                                                   Visibility="{Binding IsPlaying, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <ui:TextBlock TextWrapping="Wrap" Text="เล่น" Visibility="{Binding IsPlaying, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                                    <ui:TextBlock TextWrapping="Wrap" Text="หยุดชั่วคราว" Visibility="{Binding IsPlaying, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </StackPanel>
                            </ui:Button>

                            <!-- Position Time Display -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                                <ui:TextBlock TextWrapping="Wrap" Text="เวลาปัจจุบัน: " Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <ui:TextBlock TextWrapping="Wrap" Text="{Binding CurrentPositionFormatted}" FontWeight="Bold" Foreground="{DynamicResource SystemAccentColorLight2Brush}" />
                            </StackPanel>
                        </Grid>

                        <!-- Quick Marker Buttons -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <ui:Button MinHeight="36" FocusVisualStyle="{StaticResource KeyboardFocus}" Grid.Column="0" Content="ตั้งเป็นจุดเริ่มต้น"
                                       Command="{Binding SetStartToCurrentCommand}"
                                       IsEnabled="{Binding CanEdit}"
                                       HorizontalAlignment="Stretch" Margin="0,0,4,0" />

                            <ui:Button MinHeight="36" FocusVisualStyle="{StaticResource KeyboardFocus}" Grid.Column="1" Content="ตั้งเป็นจุดสิ้นสุด"
                                       Command="{Binding SetEndToCurrentCommand}"
                                       IsEnabled="{Binding CanEdit}"
                                       HorizontalAlignment="Stretch" Margin="4,0,0,0" />
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Right Column: Trim Sliders & Action Buttons -->
            <Border Grid.Column="2" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="8" Padding="20" BorderThickness="1"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Time Summary Badges -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="6" Padding="12" Margin="0,0,4,0">
                            <StackPanel HorizontalAlignment="Center">
                                <ui:TextBlock TextWrapping="Wrap" Text="เวลาเริ่ม" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" />
                                <ui:TextBlock TextWrapping="Wrap" Text="{Binding StartTimeFormatted}" FontWeight="Bold" FontSize="15" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="6" Padding="12" Margin="2,0,2,0">
                            <StackPanel HorizontalAlignment="Center">
                                <ui:TextBlock TextWrapping="Wrap" Text="เวลาสิ้นสุด" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" />
                                <ui:TextBlock TextWrapping="Wrap" Text="{Binding EndTimeFormatted}" FontWeight="Bold" FontSize="15" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="6" Padding="12" Margin="4,0,0,0">
                            <StackPanel HorizontalAlignment="Center">
                                <ui:TextBlock TextWrapping="Wrap" Text="ความยาวหลังตัด" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" />
                                <ui:TextBlock TextWrapping="Wrap" Text="{Binding TrimDurationFormatted}" FontWeight="Bold" FontSize="15" Margin="0,2,0,0" Foreground="{DynamicResource SystemAccentColorLight2Brush}" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Slider 1: Start Time -->
                    <StackPanel Grid.Row="1" Margin="0,0,0,14">
                        <WrapPanel Margin="0,0,0,4">
                        <ui:TextBlock TextWrapping="Wrap" Text="จุดเริ่มต้น:" FontWeight="SemiBold"  />
                            <StackPanel Orientation="Horizontal" Margin="12,0,0,0">
                                <ui:Button MinHeight="36" FocusVisualStyle="{StaticResource KeyboardFocus}" Content="ข้ามไปจุดนี้" Icon="{ui:SymbolIcon Symbol=ChevronRight16}"
                                           Command="{Binding SeekToStartCommand}" Padding="6,2" Margin="0,0,6,0" FontSize="12" />
                                <ui:TextBlock TextWrapping="Wrap" Text="{Binding StartTimeFormatted}" VerticalAlignment="Center" FontWeight="SemiBold" />
                            </StackPanel>
                        </WrapPanel>
                        <Slider Minimum="0" Maximum="{Binding TotalSeconds}" Value="{Binding StartSeconds}"
                                ValueChanged="StartSlider_ValueChanged"
                                TickFrequency="1" IsSnapToTickEnabled="False" IsEnabled="{Binding CanEdit}" />
                    </StackPanel>

                    <!-- Slider 2: End Time -->
                    <StackPanel Grid.Row="2" Margin="0,0,0,16">
                        <WrapPanel Margin="0,0,0,4">
                        <ui:TextBlock TextWrapping="Wrap" Text="จุดสิ้นสุด:" FontWeight="SemiBold"  />
                            <StackPanel Orientation="Horizontal" Margin="12,0,0,0">
                                <ui:Button MinHeight="36" FocusVisualStyle="{StaticResource KeyboardFocus}" Content="ข้ามไปจุดนี้" Icon="{ui:SymbolIcon Symbol=ChevronRight16}"
                                           Command="{Binding SeekToEndCommand}" Padding="6,2" Margin="0,0,6,0" FontSize="12" />
                                <ui:TextBlock TextWrapping="Wrap" Text="{Binding EndTimeFormatted}" VerticalAlignment="Center" FontWeight="SemiBold" />
                            </StackPanel>
                        </WrapPanel>
                        <Slider Minimum="0" Maximum="{Binding TotalSeconds}" Value="{Binding EndSeconds}"
                                ValueChanged="EndSlider_ValueChanged"
                                TickFrequency="1" IsSnapToTickEnabled="False" IsEnabled="{Binding CanEdit}" />
                    </StackPanel>

                    <!-- Options -->
                    <ui:TextBlock TextWrapping="Wrap" Grid.Row="3" Text="ตัดแบบรักษาคุณภาพเดิมโดยไม่เข้ารหัสวิดีโอใหม่"
                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontWeight="SemiBold" Margin="0,0,0,16" />

                    <!-- Status Text -->
                    <ui:TextBlock Grid.Row="4" Text="{Binding StatusText}" VerticalAlignment="Center"
                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,12" />

                    <!-- Action Buttons -->
                    <StackPanel Grid.Row="5"><views:OutputLocationView DataContext="{Binding DataContext.OutputLocation, RelativeSource={RelativeSource AncestorType=Window}}"/>
                     <ui:Button MinHeight="36" FocusVisualStyle="{StaticResource KeyboardFocus}" Content="เริ่มตัดวิดีโอ" Appearance="Primary" Command="{Binding StartTrimCommand}" IsEnabled="{Binding CanEdit}" HorizontalAlignment="Left"/>
                     <StackPanel Margin="0,16,0,0" Visibility="{Binding HasLastTrimmedPath, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="{Binding LastTrimmedPath}" Style="{StaticResource SecondaryText}" Margin="0,0,0,8"/><views:ResultActionsView OpenFileCommand="{Binding PlayLastTrimmedCommand}" OpenFolderCommand="{Binding OpenLastTrimmedFolderCommand}" SendToConverterCommand="{Binding SendToConverterCommand}" SendToAudioCommand="{Binding SendToAudioTrimmerCommand}"/></StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </views:ResponsiveColumnsPanel>
    </Grid></ScrollViewer>
</UserControl>
