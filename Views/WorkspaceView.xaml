<UserControl x:Class="MediaStudio.Views.WorkspaceView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
 <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,18"><ui:TextBlock Text="คลังงาน Media Workspace" FontTypography="Title"/><ui:TextBlock Text="ไฟล์ที่นำเข้าและผลลัพธ์ล่าสุด 50 รายการ ส่งต่อไปยังเครื่องมืออื่นได้ทันที" Margin="0,4,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/></StackPanel>
  <Border Grid.Row="1" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
   <ListBox ItemsSource="{Binding Assets}" Background="Transparent" BorderThickness="0">
    <ListBox.ItemTemplate><DataTemplate><Border Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="6" Padding="12" Margin="0,0,0,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel><ui:TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><StackPanel Orientation="Horizontal" Margin="0,3,0,0"><ui:TextBlock Text="{Binding KindLabel}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/><ui:TextBlock Text="{Binding SourceTool, StringFormat='  |  {0}'}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/><ui:TextBlock Text="{Binding CreatedAtFormatted, StringFormat='  |  {0}'}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/></StackPanel><ui:TextBlock Text="{Binding FilePath}" FontSize="11" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/></StackPanel>
     <StackPanel Grid.Column="1" Orientation="Horizontal"><ui:Button Content="แปลง" Command="{Binding DataContext.SendToConverterCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" Margin="0,0,5,0"/><ui:Button Content="ตัดวิดีโอ" Command="{Binding DataContext.SendToVideoTrimmerCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" IsEnabled="{Binding CanOpenInVideoTrimmer}" Margin="0,0,5,0"/><ui:Button Content="ตัดเสียง" Command="{Binding DataContext.SendToAudioTrimmerCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" IsEnabled="{Binding CanOpenInAudioTrimmer}" Margin="0,0,5,0"/><ui:Button Content="เปิด" Command="{Binding DataContext.OpenFileCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" Margin="0,0,5,0"/><ui:Button Content="โฟลเดอร์" Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" Margin="0,0,5,0"/><ui:Button Content="นำออก" Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"/></StackPanel>
    </Grid></Border></DataTemplate></ListBox.ItemTemplate>
   </ListBox>
  </Border>
 </Grid>
</UserControl>
