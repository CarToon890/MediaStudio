<UserControl x:Class="MediaStudio.Views.WorkspaceView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:MediaStudio.Views" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
 <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,18"><ui:TextBlock TextWrapping="Wrap" Text="คลังงาน" FontTypography="Title"/><ui:TextBlock Text="รวมไฟล์ที่นำเข้าและผลลัพธ์ล่าสุด 50 รายการ เพื่อเปิดหรือส่งต่อไปยังเครื่องมืออื่น — ลบออกจากประวัติแล้วไฟล์ในเครื่องจะไม่ถูกลบ" TextWrapping="Wrap" Margin="0,4,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/><TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite"/></StackPanel>
  <Border Grid.Row="1" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
   <Grid>
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding HasAssets, Converter={StaticResource InverseBooleanToVisibilityConverter}}"><ui:SymbolIcon Symbol="FolderOpen24" FontSize="34" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/><ui:TextBlock TextWrapping="Wrap" Text="ยังไม่มีไฟล์ในคลังงาน" FontTypography="Subtitle" Margin="0,10,0,0" HorizontalAlignment="Center"/><ui:TextBlock TextWrapping="Wrap" Text="ไฟล์ที่เปิด ดาวน์โหลด แปลง หรือตัดเสร็จแล้วจะแสดงที่นี่" Margin="0,4,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/></StackPanel>
    <ListBox ItemsSource="{Binding Assets}" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
     <ListBox.ItemTemplate><DataTemplate><Border Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="6" Padding="12" Margin="0,0,0,8"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel><ui:TextBlock TextWrapping="Wrap" Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><WrapPanel Margin="0,3,0,0"><ui:TextBlock TextWrapping="Wrap" Text="{Binding KindLabel}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/><ui:TextBlock TextWrapping="Wrap" Text="{Binding SourceTool, StringFormat='  |  {0}'}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/><ui:TextBlock TextWrapping="Wrap" Text="{Binding CreatedAtFormatted, StringFormat='  |  {0}'}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/></WrapPanel><ui:TextBlock TextWrapping="Wrap" Text="{Binding FilePath}" FontSize="12" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/></StackPanel>
      <StackPanel Grid.Row="1" Margin="0,12,0,0"><views:ResultActionsView OpenFileCommand="{Binding DataContext.OpenFileCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" OpenFolderCommand="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" SendToConverterCommand="{Binding DataContext.SendToConverterCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" SendToVideoCommand="{Binding DataContext.SendToVideoTrimmerCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" SendToAudioCommand="{Binding DataContext.SendToAudioTrimmerCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CanSendVideo="{Binding CanOpenInVideoTrimmer}" CanSendAudio="{Binding CanOpenInAudioTrimmer}" CommandParameter="{Binding}"/><ui:Button MinHeight="36" FocusVisualStyle="{StaticResource KeyboardFocus}" Content="ลบออกจากประวัติ" ToolTip="ไฟล์ในเครื่องจะไม่ถูกลบ" Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" HorizontalAlignment="Left"/></StackPanel>
     </Grid></Border></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
   </Grid>
  </Border>
 </Grid>
</UserControl>
