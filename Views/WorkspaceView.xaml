<UserControl x:Class="MediaStudio.Views.WorkspaceView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
 <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,18"><ui:TextBlock Text="คลังงาน" FontTypography="Title"/><ui:TextBlock Text="รวมไฟล์ที่นำเข้าและผลลัพธ์ล่าสุด 50 รายการ เพื่อเปิดหรือส่งต่อไปยังเครื่องมืออื่น" TextWrapping="Wrap" Margin="0,4,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/></StackPanel>
  <Border Grid.Row="1" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
   <Grid>
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding HasAssets, Converter={StaticResource InverseBooleanToVisibilityConverter}}"><ui:SymbolIcon Symbol="FolderOpen24" FontSize="34" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/><ui:TextBlock Text="ยังไม่มีไฟล์ในคลังงาน" FontTypography="Subtitle" Margin="0,10,0,0" HorizontalAlignment="Center"/><ui:TextBlock Text="ไฟล์ที่เปิด ดาวน์โหลด แปลง หรือตัดเสร็จแล้วจะแสดงที่นี่" Margin="0,4,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/></StackPanel>
    <ListBox ItemsSource="{Binding Assets}" Background="Transparent" BorderThickness="0">
     <ListBox.ItemTemplate><DataTemplate><Border Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="6" Padding="12" Margin="0,0,0,8"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel><ui:TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><WrapPanel Margin="0,3,0,0"><ui:TextBlock Text="{Binding KindLabel}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/><ui:TextBlock Text="{Binding SourceTool, StringFormat='  |  {0}'}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/><ui:TextBlock Text="{Binding CreatedAtFormatted, StringFormat='  |  {0}'}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/></WrapPanel><ui:TextBlock Text="{Binding FilePath}" FontSize="11" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/></StackPanel>
      <WrapPanel Grid.Row="1" Margin="0,10,0,0"><ui:Button Content="แปลง" Command="{Binding DataContext.SendToConverterCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" Margin="0,0,5,5"/><ui:Button Content="ตัดวิดีโอ" Command="{Binding DataContext.SendToVideoTrimmerCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" IsEnabled="{Binding CanOpenInVideoTrimmer}" Margin="0,0,5,5"/><ui:Button Content="ตัดเสียง" Command="{Binding DataContext.SendToAudioTrimmerCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" IsEnabled="{Binding CanOpenInAudioTrimmer}" Margin="0,0,5,5"/><ui:Button Content="เปิดไฟล์" Command="{Binding DataContext.OpenFileCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" Margin="0,0,5,5"/><ui:Button Content="เปิดโฟลเดอร์" Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" Margin="0,0,5,5"/><ui:Button Content="นำออกจากคลัง" Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" Margin="0,0,0,5"/></WrapPanel>
     </Grid></Border></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
   </Grid>
  </Border>
 </Grid>
</UserControl>
