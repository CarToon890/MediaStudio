<ui:FluentWindow x:Class="MediaStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:views="clr-namespace:MediaStudio.Views"
        xmlns:viewmodels="clr-namespace:MediaStudio.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=viewmodels:MainViewModel}"
        Title="MediaStudio - Windows 11 Media Suite" 
        Height="780" Width="1100" MinHeight="600" MinWidth="850"
        WindowStartupLocation="CenterScreen">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- TitleBar -->
        <ui:TitleBar Grid.Row="0" Title="MediaStudio" Icon="pack://application:,,,/Wpf.Ui;component/Assets/wpfui-icon-256.png" />

        <!-- Main Content Area with Navigation Menu -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar Navigation -->
            <Border Grid.Column="0" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                    BorderThickness="0,0,1,0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="8,12,8,20">
                        <ui:TextBlock Text="MediaStudio" FontTypography="Title" />
                        <ui:TextBlock Text="All-in-One Media Suite" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <!-- Nav Buttons -->
                    <StackPanel Grid.Row="1">
                        <ui:Button Content="{Binding DownloaderNavTitle}" Icon="{ui:SymbolIcon Symbol=ArrowDownload24}" 
                                   HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                   Command="{Binding NavigateCommand}" CommandParameter="Downloader" 
                                   Padding="12,10" Margin="0,0,0,6">
                            <ui:Button.Style>
                                <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                    <Setter Property="Appearance" Value="Secondary" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentTab}" Value="Downloader">
                                            <Setter Property="Appearance" Value="Primary" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:Button.Style>
                        </ui:Button>

                        <ui:Button Content="{Binding ConverterNavTitle}" Icon="{ui:SymbolIcon Symbol=ArrowSync24}" 
                                   HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                   Command="{Binding NavigateCommand}" CommandParameter="Converter" 
                                   Padding="12,10" Margin="0,0,0,6">
                            <ui:Button.Style>
                                <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                    <Setter Property="Appearance" Value="Secondary" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentTab}" Value="Converter">
                                            <Setter Property="Appearance" Value="Primary" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:Button.Style>
                        </ui:Button>

                        <ui:Button Content="Video Trimmer" Icon="{ui:SymbolIcon Symbol=Cut24}" 
                                   HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                   Command="{Binding NavigateCommand}" CommandParameter="Trimmer" 
                                   Padding="12,10" Margin="0,0,0,6">
                            <ui:Button.Style>
                                <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                    <Setter Property="Appearance" Value="Secondary" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentTab}" Value="Trimmer">
                                            <Setter Property="Appearance" Value="Primary" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:Button.Style>
                        </ui:Button>
                    </StackPanel>

                    <!-- Bottom Nav -->
                    <StackPanel Grid.Row="2">
                        <ui:Button Content="Settings" Icon="{ui:SymbolIcon Symbol=Settings24}" 
                                   HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                   Command="{Binding NavigateCommand}" CommandParameter="Settings" Padding="12,10">
                            <ui:Button.Style>
                                <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                    <Setter Property="Appearance" Value="Secondary" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentTab}" Value="Settings">
                                            <Setter Property="Appearance" Value="Primary" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:Button.Style>
                        </ui:Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Content Area View Switching -->
            <Grid Grid.Column="1">
                <!-- Downloader View -->
                <views:DownloaderView DataContext="{Binding DownloaderVm}">
                    <views:DownloaderView.Style>
                        <Style TargetType="views:DownloaderView">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DataContext.CurrentTab, RelativeSource={RelativeSource AncestorType=ui:FluentWindow}}" Value="Downloader">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </views:DownloaderView.Style>
                </views:DownloaderView>

                <!-- Converter View -->
                <views:ConverterView DataContext="{Binding ConverterVm}">
                    <views:ConverterView.Style>
                        <Style TargetType="views:ConverterView">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DataContext.CurrentTab, RelativeSource={RelativeSource AncestorType=ui:FluentWindow}}" Value="Converter">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </views:ConverterView.Style>
                </views:ConverterView>

                <!-- Trimmer View -->
                <views:TrimmerView DataContext="{Binding TrimmerVm}">
                    <views:TrimmerView.Style>
                        <Style TargetType="views:TrimmerView">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DataContext.CurrentTab, RelativeSource={RelativeSource AncestorType=ui:FluentWindow}}" Value="Trimmer">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </views:TrimmerView.Style>
                </views:TrimmerView>

                <!-- Settings View -->
                <views:SettingsView DataContext="{Binding SettingsVm}">
                    <views:SettingsView.Style>
                        <Style TargetType="views:SettingsView">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DataContext.CurrentTab, RelativeSource={RelativeSource AncestorType=ui:FluentWindow}}" Value="Settings">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </views:SettingsView.Style>
                </views:SettingsView>
            </Grid>
        </Grid>

        <!-- Footer Status Bar -->
        <Border Grid.Row="2" Background="{DynamicResource ControlFillColorDefaultBrush}" 
                BorderThickness="0,1,0,0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ui:TextBlock Grid.Column="0" Text="{Binding AppStatus}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <ui:TextBlock Grid.Column="1" Text="MediaStudio .NET 9" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
