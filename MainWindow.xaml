<ui:FluentWindow x:Class="MediaStudio.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:views="clr-namespace:MediaStudio.Views" xmlns:viewmodels="clr-namespace:MediaStudio.ViewModels" mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=viewmodels:MainViewModel}" Title="MediaStudio" Icon="pack://application:,,,/MediaStudio;component/Assets/MediaStudio.ico" Height="800" Width="1180" MinHeight="540" FontSize="14" MinWidth="960" WindowStartupLocation="CenterScreen">
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <ui:TitleBar Grid.Row="0" Title="MediaStudio" Icon="pack://application:,,,/MediaStudio;component/Assets/MediaStudio.ico"/>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="{Binding NavigationWidth}"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Padding="8">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
     <TextBlock Text="MediaStudio" FontSize="24" FontWeight="SemiBold" Margin="8,16,0,24" Visibility="{Binding IsCompactNavigation, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
     <ui:Button FocusVisualStyle="{StaticResource KeyboardFocus}" MinHeight="36" Command="{Binding NavigateCommand}" CommandParameter="Home" Appearance="{Binding CurrentTab, Converter={StaticResource ActiveTabAppearanceConverter}, ConverterParameter=Home}" ToolTip="หน้าเริ่มต้น" ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="หน้าเริ่มต้น" Padding="4,10" Margin="0,0,0,8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ui:SymbolIcon Symbol="Home24" FontSize="20"/><TextBlock Grid.Column="1" Text="หน้าเริ่มต้น" Margin="12,0,0,0" VerticalAlignment="Center" Visibility="{Binding IsCompactNavigation, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/></Grid></ui:Button>
     <ui:Button FocusVisualStyle="{StaticResource KeyboardFocus}" MinHeight="36" Command="{Binding NavigateCommand}" CommandParameter="Downloader" Appearance="{Binding CurrentTab, Converter={StaticResource ActiveTabAppearanceConverter}, ConverterParameter=Downloader}" ToolTip="{Binding DownloaderNavTitle}" ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="{Binding DownloaderNavTitle}" Padding="4,10" Margin="0,0,0,8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsEnabled="{Binding EnginesReady}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ui:SymbolIcon Symbol="ArrowDownload24" FontSize="20"/><TextBlock Grid.Column="1" Text="ดาวน์โหลด" Margin="12,0,0,0" VerticalAlignment="Center" Visibility="{Binding IsCompactNavigation, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/><TextBlock Grid.Column="2" Text="{Binding DownloaderVm.ActiveDownloadsCount}" FontSize="12" FontWeight="Bold"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Margin" Value="2,0,0,0"/><Style.Triggers><DataTrigger Binding="{Binding DownloaderVm.ActiveDownloadsCount}" Value="0"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid></ui:Button>
     <ui:Button FocusVisualStyle="{StaticResource KeyboardFocus}" MinHeight="36" Command="{Binding NavigateCommand}" CommandParameter="Converter" Appearance="{Binding CurrentTab, Converter={StaticResource ActiveTabAppearanceConverter}, ConverterParameter=Converter}" ToolTip="{Binding ConverterNavTitle}" ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="{Binding ConverterNavTitle}" Padding="4,10" Margin="0,0,0,8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsEnabled="{Binding EnginesReady}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ui:SymbolIcon Symbol="ArrowSync24" FontSize="20"/><TextBlock Grid.Column="1" Text="แปลงไฟล์" Margin="12,0,0,0" VerticalAlignment="Center" Visibility="{Binding IsCompactNavigation, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/><TextBlock Grid.Column="2" Text="{Binding ConverterVm.ActiveConversionsCount}" FontSize="12" FontWeight="Bold"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Margin" Value="2,0,0,0"/><Style.Triggers><DataTrigger Binding="{Binding ConverterVm.ActiveConversionsCount}" Value="0"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid></ui:Button>
     <ui:Button FocusVisualStyle="{StaticResource KeyboardFocus}" MinHeight="36" Command="{Binding NavigateCommand}" CommandParameter="Trimmer" Appearance="{Binding CurrentTab, Converter={StaticResource ActiveTabAppearanceConverter}, ConverterParameter=Trimmer}" ToolTip="ตัดวิดีโอ" ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="ตัดวิดีโอ" Padding="4,10" Margin="0,0,0,8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsEnabled="{Binding EnginesReady}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ui:SymbolIcon Symbol="Video24" FontSize="20"/><TextBlock Grid.Column="1" Text="ตัดวิดีโอ" Margin="12,0,0,0" VerticalAlignment="Center" Visibility="{Binding IsCompactNavigation, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/></Grid></ui:Button>
     <ui:Button FocusVisualStyle="{StaticResource KeyboardFocus}" MinHeight="36" Command="{Binding NavigateCommand}" CommandParameter="AudioTrimmer" Appearance="{Binding CurrentTab, Converter={StaticResource ActiveTabAppearanceConverter}, ConverterParameter=AudioTrimmer}" ToolTip="ตัดและปรับเสียง" ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="ตัดและปรับเสียง" Padding="4,10" Margin="0,0,0,8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsEnabled="{Binding EnginesReady}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ui:SymbolIcon Symbol="MusicNote224" FontSize="20"/><TextBlock Grid.Column="1" Text="ตัดและปรับเสียง" Margin="12,0,0,0" VerticalAlignment="Center" Visibility="{Binding IsCompactNavigation, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/></Grid></ui:Button>
     <ui:Button FocusVisualStyle="{StaticResource KeyboardFocus}" MinHeight="36" Command="{Binding NavigateCommand}" CommandParameter="Workspace" Appearance="{Binding CurrentTab, Converter={StaticResource ActiveTabAppearanceConverter}, ConverterParameter=Workspace}" ToolTip="คลังงาน" ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="คลังงาน" Padding="4,10" Margin="0,0,0,8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ui:SymbolIcon Symbol="FolderOpen24" FontSize="20"/><TextBlock Grid.Column="1" Text="คลังงาน" Margin="12,0,0,0" VerticalAlignment="Center" Visibility="{Binding IsCompactNavigation, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/></Grid></ui:Button>
     <ui:Button FocusVisualStyle="{StaticResource KeyboardFocus}" MinHeight="36" Command="{Binding NavigateCommand}" CommandParameter="Settings" Appearance="{Binding CurrentTab, Converter={StaticResource ActiveTabAppearanceConverter}, ConverterParameter=Settings}" ToolTip="ตั้งค่า" ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="ตั้งค่า" Padding="4,10" Margin="0,0,0,8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ui:SymbolIcon Symbol="Settings24" FontSize="20"/><TextBlock Grid.Column="1" Text="ตั้งค่า" Margin="12,0,0,0" VerticalAlignment="Center" Visibility="{Binding IsCompactNavigation, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/></Grid></ui:Button>
    </StackPanel></ScrollViewer>
   </Border>
   <Grid Grid.Column="1">
    <views:HomeView DataContext="{Binding}"><views:HomeView.Style><Style TargetType="views:HomeView"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding CurrentTab}" Value="Home"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></views:HomeView.Style></views:HomeView>
    <views:DownloaderView DataContext="{Binding DownloaderVm}"><views:DownloaderView.Style><Style TargetType="views:DownloaderView"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding DataContext.CurrentTab, RelativeSource={RelativeSource AncestorType=ui:FluentWindow}}" Value="Downloader"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></views:DownloaderView.Style></views:DownloaderView>
    <views:ConverterView DataContext="{Binding ConverterVm}"><views:ConverterView.Style><Style TargetType="views:ConverterView"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding DataContext.CurrentTab, RelativeSource={RelativeSource AncestorType=ui:FluentWindow}}" Value="Converter"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></views:ConverterView.Style></views:ConverterView>
    <views:TrimmerView DataContext="{Binding TrimmerVm}"><views:TrimmerView.Style><Style TargetType="views:TrimmerView"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding DataContext.CurrentTab, RelativeSource={RelativeSource AncestorType=ui:FluentWindow}}" Value="Trimmer"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></views:TrimmerView.Style></views:TrimmerView>
    <views:AudioTrimmerView DataContext="{Binding AudioTrimmerVm}"><views:AudioTrimmerView.Style><Style TargetType="views:AudioTrimmerView"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding DataContext.CurrentTab, RelativeSource={RelativeSource AncestorType=ui:FluentWindow}}" Value="AudioTrimmer"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></views:AudioTrimmerView.Style></views:AudioTrimmerView>
    <views:WorkspaceView DataContext="{Binding WorkspaceVm}"><views:WorkspaceView.Style><Style TargetType="views:WorkspaceView"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding DataContext.CurrentTab, RelativeSource={RelativeSource AncestorType=ui:FluentWindow}}" Value="Workspace"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></views:WorkspaceView.Style></views:WorkspaceView>
    <views:SettingsView DataContext="{Binding SettingsVm}"><views:SettingsView.Style><Style TargetType="views:SettingsView"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding DataContext.CurrentTab, RelativeSource={RelativeSource AncestorType=ui:FluentWindow}}" Value="Settings"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></views:SettingsView.Style></views:SettingsView>
   </Grid>
  </Grid>
  <Border Grid.Row="2" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Padding="16,8"><StackPanel><ui:TextBlock Text="{Binding Workspace.PersistenceWarning}" TextWrapping="Wrap" Margin="0,0,0,6" Visibility="{Binding Workspace.HasPersistenceWarning, Converter={StaticResource BooleanToVisibilityConverter}}" AutomationProperties.LiveSetting="Polite"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ui:TextBlock TextWrapping="Wrap" Text="{Binding AppStatus}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/><ui:TextBlock Grid.Column="1" Text="MediaStudio .NET 9" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/></Grid></StackPanel></Border>
 </Grid>
</ui:FluentWindow>
