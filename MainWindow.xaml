<ui:FluentWindow x:Class="MediaStudio.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:views="clr-namespace:MediaStudio.Views" xmlns:viewmodels="clr-namespace:MediaStudio.ViewModels" mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=viewmodels:MainViewModel}" Title="MediaStudio" Icon="Assets/MediaStudio.ico" Height="800" Width="1180" MinHeight="650" MinWidth="960" WindowStartupLocation="CenterScreen">
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <ui:TitleBar Grid.Row="0" Title="MediaStudio" Icon="pack://application:,,,/Assets/MediaStudio.png"/>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Padding="12"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="8,12,8,20"><ui:TextBlock Text="MediaStudio" FontTypography="Title"/><ui:TextBlock Text="เครื่องมือมีเดียครบวงจร" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/></StackPanel>
    <StackPanel Grid.Row="1">
     <ui:Button Content="หน้าเริ่มต้น" Command="{Binding NavigateCommand}" CommandParameter="Home" Appearance="{Binding CurrentTab, Converter={StaticResource ActiveTabAppearanceConverter}, ConverterParameter=Home}" Padding="12,9" Margin="0,0,0,5" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"/>
     <ui:Button Content="{Binding DownloaderNavTitle}" Command="{Binding NavigateCommand}" CommandParameter="Downloader" Appearance="{Binding CurrentTab, Converter={StaticResource ActiveTabAppearanceConverter}, ConverterParameter=Downloader}" IsEnabled="{Binding EnginesReady}" Padding="12,9" Margin="0,0,0,5" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"/>
     <ui:Button Content="{Binding ConverterNavTitle}" Command="{Binding NavigateCommand}" CommandParameter="Converter" Appearance="{Binding CurrentTab, Converter={StaticResource ActiveTabAppearanceConverter}, ConverterParameter=Converter}" IsEnabled="{Binding EnginesReady}" Padding="12,9" Margin="0,0,0,5" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"/>
     <ui:Button Content="ตัดวิดีโอ" Command="{Binding NavigateCommand}" CommandParameter="Trimmer" Appearance="{Binding CurrentTab, Converter={StaticResource ActiveTabAppearanceConverter}, ConverterParameter=Trimmer}" IsEnabled="{Binding EnginesReady}" Padding="12,9" Margin="0,0,0,5" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"/>
     <ui:Button Content="ตัดเสียง" Command="{Binding NavigateCommand}" CommandParameter="AudioTrimmer" Appearance="{Binding CurrentTab, Converter={StaticResource ActiveTabAppearanceConverter}, ConverterParameter=AudioTrimmer}" IsEnabled="{Binding EnginesReady}" Padding="12,9" Margin="0,0,0,5" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"/>
     <ui:Button Content="คลังงาน" Command="{Binding NavigateCommand}" CommandParameter="Workspace" Appearance="{Binding CurrentTab, Converter={StaticResource ActiveTabAppearanceConverter}, ConverterParameter=Workspace}" Padding="12,9" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"/>
    </StackPanel>
    <ui:Button Grid.Row="2" Content="ตั้งค่า" Command="{Binding NavigateCommand}" CommandParameter="Settings" Appearance="{Binding CurrentTab, Converter={StaticResource ActiveTabAppearanceConverter}, ConverterParameter=Settings}" Padding="12,9" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"/>
   </Grid></Border>
   <Grid Grid.Column="1">
    <views:HomeView DataContext="{Binding}"><views:HomeView.Style><Style TargetType="views:HomeView"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding CurrentTab}" Value="Home"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></views:HomeView.Style></views:HomeView>
    <views:DownloaderView DataContext="{Binding DownloaderVm}"><views:DownloaderView.Style><Style TargetType="views:DownloaderView"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding DataContext.CurrentTab, RelativeSource={RelativeSource AncestorType=ui:FluentWindow}}" Value="Downloader"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></views:DownloaderView.Style></views:DownloaderView>
    <views:ConverterView DataContext="{Binding ConverterVm}"><views:ConverterView.Style><Style TargetType="views:ConverterView"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding DataContext.CurrentTab, RelativeSource={RelativeSource AncestorType=ui:FluentWindow}}" Value="Converter"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></views:ConverterView.Style></views:ConverterView>
    <views:TrimmerView DataContext="{Binding TrimmerVm}"><views:TrimmerView.Style><Style TargetType="views:TrimmerView"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding DataContext.CurrentTab, RelativeSource={RelativeSource AncestorType=ui:FluentWindow}}" Value="Trimmer"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></views:TrimmerView.Style></views:TrimmerView>
    <views:AudioTrimmerView DataContext="{Binding AudioTrimmerVm}"><views:AudioTrimmerView.Style><Style TargetType="views:AudioTrimmerView"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding DataContext.CurrentTab, RelativeSource={RelativeSource AncestorType=ui:FluentWindow}}" Value="AudioTrimmer"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></views:AudioTrimmerView.Style></views:AudioTrimmerView>
    <views:WorkspaceView DataContext="{Binding WorkspaceVm}"><views:WorkspaceView.Style><Style TargetType="views:WorkspaceView"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding DataContext.CurrentTab, RelativeSource={RelativeSource AncestorType=ui:FluentWindow}}" Value="Workspace"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></views:WorkspaceView.Style></views:WorkspaceView>
    <views:SettingsView DataContext="{Binding SettingsVm}"><views:SettingsView.Style><Style TargetType="views:SettingsView"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding DataContext.CurrentTab, RelativeSource={RelativeSource AncestorType=ui:FluentWindow}}" Value="Settings"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></views:SettingsView.Style></views:SettingsView>
   </Grid>
  </Grid>
  <Border Grid.Row="2" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Padding="16,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ui:TextBlock Text="{Binding AppStatus}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/><ui:TextBlock Grid.Column="1" Text="MediaStudio .NET 9" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/></Grid></Border>
 </Grid>
</ui:FluentWindow>
